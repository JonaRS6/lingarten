rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdministrator() {
      return request.auth != null
        && request.auth.token.email in [
          "jersneme6@gmail.com",
          "lingartendmor@gmail.com"
        ]
        && request.auth.token.email_verified == true;
    }

    // The dashboard contains customer and billing data. Only verified
    // administrator accounts may access it.
    match /{collection}/{document=**} {
      allow read: if isAdministrator();
      // Payments, references and their counter are written only by functions.
      allow write: if isAdministrator()
        && !(collection in ['clients', 'payments', 'paymentRefs', 'counters']);
    }

    // A client's reference and credit are kept by functions, so a stale form
    // cannot overwrite them.
    match /clients/{clientId} {
      allow create: if isAdministrator()
        && !request.resource.data.keys().hasAny(['paymentRef', 'credit']);
      allow update: if isAdministrator()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentRef', 'credit']);
      allow delete: if isAdministrator();

      match /{subcollection}/{document=**} {
        allow write: if isAdministrator();
      }
    }
  }
}

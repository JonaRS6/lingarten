rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == "jersneme6@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // The dashboard contains customer and billing data. Only the verified owner
    // account may access it until additional roles are deliberately introduced.
    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}

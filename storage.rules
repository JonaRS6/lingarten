rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdministrator() {
      return request.auth != null
        && request.auth.token.email in [
          "jersneme6@gmail.com",
          "lingartendmor@gmail.com"
        ]
        && request.auth.token.email_verified == true;
    }

    match /{allPaths=**} {
      allow read, write: if isAdministrator();
    }
  }
}
